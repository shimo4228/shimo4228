        "https://doi.org/10.5281/zenodo.20262112"
      ],
      "derivesFrom": "https://doi.org/10.5281/zenodo.19212118",
      "definesConcept": [
        "https://shimo4228.github.io/shimo4228/vocab#concept/four-business-ai-quadrants",
